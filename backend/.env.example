# InstaCoServe Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_sahakar_seva_2026_coop

# Optional Third-Party API Keys (System works 100% in fallback mode with empty keys)
# Conversational & Intent LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Maps (Falls back to OpenStreetMap Nominatim if empty)
GOOGLE_MAPS_API_KEY=

# Razorpay (Falls back to Mock / Sandbox UPI mode if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bhashini Voice (Falls back to Multilingual text UI if empty)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Telecom SMS Gateway (Falls back to console simulator if empty)
SMS_GATEWAY_API_KEY=
